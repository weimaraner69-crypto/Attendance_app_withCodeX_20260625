{
  "default_tier": "green",
  "yellow_if_touches": [
    "src/**",
    "scripts/**",
    "ci/**",
    ".github/agents/**"
  ],
  "red_if_touches": [
    "src/**/migrations/**",
    "supabase/migrations/**",
    "src/**/auth/**",
    "src/**/*auth*",
    "src/**/*permission*",
    "src/**/*role*",
    "src/**/*supabase*",
    "src/lib/auth/**",
    "src/lib/supabase/**",
    "src/lib/external-api/**",
    "src/lib/validations/auth.ts",
    "src/stores/*auth*",
    "src/app/(authenticated)/**",
    "src/app/(manager)/**",
    "src/app/auth/**",
    "src/components/auth/**",
    "src/app/api/**",
    ".github/actions/**",
    ".github/workflows/**",
    ".github/instructions/**",
    "ai/**",
    "ci/policy_check.py",
    "ci/requirements.txt",
    "docs/ai/review-result.schema.json",
    "package.json",
    "package-lock.json",
    "pyproject.toml",
    "uv.lock",
    "SECURITY.md",
    ".env*",
    "**/.env*",
    "configs/**",
    "project-config.yml",
    "tsconfig.json",
    "next.config.*",
    "tailwind.config.*",
    "postcss.config.*",
    "vercel.json"
