{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./review-result.schema.json",
  "title": "Repo-aware AI review result",
  "type": "object",
  "required": [
    "schema_version",
    "phase",
    "provider",
    "reviewer_id",
    "review_session_id",
    "implementation_session_id",
    "head_sha",
    "diff_fingerprint",
    "risk_tier",
    "round",
    "review_status",
    "secondary_verification",
    "summary",
    "repository_context_mode",
    "diff_only_reason",
    "changed_files",
    "related_files",
    "scanned_paths",
    "commands_run",
    "context_fingerprint",
    "context_budget",
    "context_truncated",
    "context_truncated_reason",
    "issues"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "phase": {
      "const": "post_push"
    },
    "provider": {
      "type": "string",
      "enum": ["codex", "claude", "copilot"]
    },
    "reviewer_id": {
      "type": "string",
      "minLength": 1
    },
    "review_session_id": {
      "type": "string",
      "minLength": 1
    },
    "implementation_session_id": {
      "type": "string",
      "minLength": 1
    },
    "head_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "diff_fingerprint": {
      "type": "string",
      "minLength": 1
    },
    "risk_tier": {
      "type": "string",
      "enum": ["green", "yellow", "red"]
    },
    "round": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "review_status": {
      "type": "string",
      "enum": ["completed", "blocked"]
    },
    "secondary_verification": {
      "type": "object",
      "required": ["required", "method", "status", "evidence", "commands"],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "method": {
          "type": "string",
          "enum": ["not_required", "independent_review", "dedicated_tests"]
        },
        "status": {
          "type": "string",
          "enum": ["not_required", "passed", "failed", "pending"]
        },
        "evidence": {
          "type": "string"
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["command", "exit_code", "summary", "covered_paths"],
            "properties": {
              "command": {
                "type": "string",
                "minLength": 1
              },
              "exit_code": {
                "const": 0
              },
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "covered_paths": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "repository_context_mode": {
      "type": "string",
      "enum": ["diff_only", "related_context", "full_repo_agentic"]
    },
    "diff_only_reason": {
      "type": "string"
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "related_files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "reason"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "score": {
            "type": "integer",
            "minimum": 0
          },
          "excerpt": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "scanned_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "commands_run": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["command", "exit_code", "summary"],
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "exit_code": {
            "type": "integer"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "context_fingerprint": {
      "type": "string",
      "minLength": 1
    },
    "context_budget": {
      "type": "object",
      "required": [
        "max_related_files",
        "max_context_chars",
        "max_file_excerpt_chars",
        "max_context_commands"
      ],
      "properties": {
        "max_related_files": {
          "type": "integer",
          "minimum": 1
        },
        "max_context_chars": {
          "type": "integer",
          "minimum": 1
        },
        "max_file_excerpt_chars": {
          "type": "integer",
          "minimum": 1
        },
        "max_context_commands": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "context_truncated": {
      "type": "boolean"
    },
    "context_truncated_reason": {
      "type": "string"
    },
    "context_budget_override_reason": {
      "type": "string"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "category", "file", "line", "rationale", "fix", "confidence", "disposition", "disposition_reason"],
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["Must", "Should", "Nice"]
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "fix": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "disposition": {
            "type": "string",
            "enum": ["open", "fixed", "backlog", "rejected"]
          },
          "disposition_reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "repository_context_mode": {"const": "diff_only"}
        }
      },
      "then": {
        "properties": {
          "diff_only_reason": {"minLength": 1},
          "risk_tier": {"const": "green"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "risk_tier": {"const": "yellow"}
        }
      },
      "then": {
        "properties": {
          "secondary_verification": {
            "properties": {
              "required": {"const": true},
              "method": {"const": "dedicated_tests"},
              "status": {"const": "passed"},
              "evidence": {"minLength": 1},
              "commands": {"minItems": 1}
            }
          }
        }
      }
    }
  ]
}
